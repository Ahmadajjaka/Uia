      "type": "object",
      "properties": {
        "inviteeUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "inviteeName": { "type": "string", "maxLength": 120 },
        "inviterUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referralCode": { "type": "string", "maxLength": 24, "pattern": "^MAMO-[A-Z0-9]{6,12}$" },
        "inviterBonus": { "type": "number" },
        "inviteeBonus": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteeUid", "inviteeName", "inviterUid", "referralCode", "inviterBonus", "inviteeBonus", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User account profiles and localization preferences"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/FounderAdmin" },
      "description": "UID-bound Super Admin registry exclusively for Founder Ahmed Nawar Al-Mamo"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "AI Doctor clinical conversation headers"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConversationMessage" },
      "description": "AI Doctor conversation messages"
    },
    "/diagnosis_cases/{caseId}": {
      "schema": { "$ref": "#/entities/DiagnosisCase" },
      "description": "Saved differential diagnosis workups"
    },
    "/lab_results/{labId}": {
      "schema": { "$ref": "#/entities/LabResult" },
      "description": "Saved laboratory panels and biomarker interpretations"
    },
    "/radiology_reports/{scanId}": {
      "schema": { "$ref": "#/entities/RadiologyReport" },
      "description": "Saved radiology studies and findings"
    },
    "/patient_records/{recordId}": {
      "schema": { "$ref": "#/entities/PatientRecord" },
      "description": "Clinician-owned patient records"
    },
    "/patient_visits/{visitId}": {
      "schema": { "$ref": "#/entities/PatientVisit" },
      "description": "Clinician-owned patient encounter visits"
    },
    "/medical_reports/{reportId}": {
      "schema": { "$ref": "#/entities/MedicalReport" },
      "description": "Clinician-owned formal medical reports"
    },
    "/health_logs/{logId}": {
      "schema": { "$ref": "#/entities/HealthLog" },
      "description": "Personal health vitals, symptoms, and medication logs"
    },
    "/medschool_progress/{progressId}": {
      "schema": { "$ref": "#/entities/MedSchoolProgress" },
