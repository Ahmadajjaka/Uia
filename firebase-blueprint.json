        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "userName", "requestType", "requestedPoints", "paymentReference", "note", "status", "createdAt", "updatedAt"]
    },
    "PointTransaction": {
      "title": "PointTransaction",
      "description": "Immutable points credit/debit ledger entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "txType": { "type": "string", "enum": ["credit", "debit", "pro_grant"] },
        "featureKey": { "type": "string", "maxLength": 80 },
        "pointsDelta": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "description": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "actorUid", "txType", "featureKey", "pointsDelta", "balanceAfter", "description", "createdAt"]
    },
    "FeaturePricingCatalog": {
      "title": "FeaturePricingCatalog",
      "description": "Founder-managed point cost per feature and Pro feature access gates",
      "type": "object",
      "properties": {
        "costs": { "type": "object" },
        "proFeatures": { "type": "array" },
        "starterApprovalPoints": { "type": "number" },
        "proMonthlyPointsBonus": { "type": "number" },
        "updatedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["costs", "proFeatures", "starterApprovalPoints", "proMonthlyPointsBonus", "updatedByUid", "updatedAt"]
    },
    "ReferralCodeLookup": {
      "title": "ReferralCodeLookup",
      "description": "Non-PII directory mapping a referral code (MAMO-XXXXXXXX) to its owning clinician UID",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 24, "pattern": "^MAMO-[A-Z0-9]{6,12}$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "ownerUid", "ownerName", "createdAt"]
    },
    "ReferralInvite": {
      "title": "ReferralInvite",
      "description": "Colleague invitation record created by an authenticated user",
      "type": "object",
      "properties": {
        "inviterUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "inviterName": { "type": "string", "maxLength": 120 },
        "referralCode": { "type": "string", "maxLength": 24, "pattern": "^MAMO-[A-Z0-9]{6,12}$" },
