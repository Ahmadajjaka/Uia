        "grokEnabled": { "type": "boolean" },
        "grokModel": { "type": "string", "maxLength": 120 },
        "zaiEnabled": { "type": "boolean" },
        "zaiModel": { "type": "string", "maxLength": 120 },
        "guestModeEnabled": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "dailyRequestLimit": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["grokEnabled", "grokModel", "zaiEnabled", "zaiModel", "guestModeEnabled", "maintenanceMode", "dailyRequestLimit", "updatedAt"]
    },
    "AccessRequest": {
      "title": "AccessRequest",
      "description": "Login approval request routed to Founder Admin before full workspace unlock",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 120 },
        "requestedRole": { "type": "string", "enum": ["clinician", "student", "patient"] },
        "institutionOrSpecialty": { "type": "string", "maxLength": 160 },
        "note": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedByEmail": { "type": "string", "maxLength": 254 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "displayName", "requestedRole", "institutionOrSpecialty", "note", "status", "createdAt", "updatedAt"]
    },
    "TopupRequest": {
      "title": "TopupRequest",
      "description": "User request to recharge points or upgrade to Pro membership reviewed by Founder Admin",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "userName": { "type": "string", "maxLength": 120 },
        "requestType": { "type": "string", "enum": ["points", "pro_upgrade"] },
        "requestedPoints": { "type": "number" },
        "paymentReference": { "type": "string", "maxLength": 160 },
        "note": { "type": "string", "maxLength": 500 },
