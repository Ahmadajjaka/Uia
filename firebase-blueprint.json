      },
      "required": ["userId", "title", "body", "read", "createdAt"]
    },
    "GuestAnalyticsEvent": {
      "title": "GuestAnalyticsEvent",
      "description": "Non-PII guest exploration event for Founder Analytics",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "moduleVisited": { "type": "string", "maxLength": 80 },
        "language": { "type": "string", "enum": ["en", "ar"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "moduleVisited", "language", "createdAt"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Founder-managed platform and AI model routing configuration (never stores raw API keys)",
      "type": "object",
