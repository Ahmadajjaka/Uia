# APP_URL: The URL where this applet is hosted.
APP_URL=MY_APP_URL

# ADMIN_EMAIL: Exclusive Founder & Super Admin verified Google email (Ahmed Nawar Al-Mamo).
ADMIN_EMAIL=ghifaramamo@gmail.com

# GROQ_API_KEY: Server-side Groq Cloud API key for openai/gpt-oss-120b clinical reasoning and chat.
GROQ_API_KEY=

# GROK_API_KEY: Optional xAI Grok API key (if using grok-* models instead of Groq Cloud).
GROK_API_KEY=

# ZAI_API_KEY: Server-side Z.AI GLM Vision API key for medical image and lab scan analysis.
ZAI_API_KEY=

# Optional default model overrides
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
ZAI_DEFAULT_MODEL=glm-4.5v

# FIREBASE_PROJECT_ID: Firebase Project ID for server-side token verification on Vercel
FIREBASE_PROJECT_ID=ai-studio-applet-webapp-37be9

